# Copie para .env.local e preencha. Nunca versione o .env.local.

# URL pública do site, usada em metadados e Open Graph.
NEXT_PUBLIC_SITE_URL="https://acassium.com.br"

# Contato — formato internacional, apenas dígitos (ex.: 5511999999999).
# Enquanto não for preenchido, o botão de WhatsApp fica desativado na interface.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL="contato@acassium.com.br"

# --- Fase 1, backend (ainda não conectado no scaffold) ---
# Postgres. Dado de carteira é dado sensível: exija TLS na string de conexão.
DATABASE_URL="postgresql://user:password@localhost:5432/acassium?sslmode=require"

# Chave de criptografia em repouso dos campos sensíveis da carteira.
# Gere com: openssl rand -base64 32
#
# ATENÇÃO: perder esta chave significa perder toda a carteira de todos os
# usuários, de forma irreversível — o backup do Postgres sozinho não recupera
# nada. Guarde uma cópia em cofre de segredos. Variável de ambiente na Vercel
# é configuração, não backup.
#
# Use chaves diferentes por ambiente: desenvolvimento nunca deve conseguir ler
# um dump de produção.
FIELD_ENCRYPTION_KEY=""

# Segredo de sessão da autenticação. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# --- Envio de e-mail (recuperação de senha) ---
# Sem a chave, o e-mail é escrito no log do servidor em desenvolvimento — dá
# para percorrer o fluxo inteiro sem provedor. Em produção, a ausência da chave
# é erro: um "esqueci minha senha" que não envia nada é pior que um que recusa.
# Crie a chave em resend.com e verifique o domínio remetente.
RESEND_API_KEY=""
EMAIL_FROM="Acássium Invest <nao-responda@acassium.com.br>"
