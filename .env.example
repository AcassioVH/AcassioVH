# Copie para .env.local. Nenhuma delas é obrigatória para o site rodar.

# URL pública, usada em metadados e Open Graph.
NEXT_PUBLIC_SITE_URL="https://acassium.com.br"

# Contato — formato internacional, apenas dígitos (ex.: 5582981290546).
# Sem um número válido, o botão de WhatsApp cai para e-mail.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL="contato@acassium.com.br"

# Identificação do controlador, exibida nas páginas legais.
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_LEGAL_DOCUMENT=""

# Defina como "true" depois que um advogado revisar os textos legais —
# é isso que retira o aviso de "documento em elaboração" da tela.
NEXT_PUBLIC_LEGAL_REVIEWED=""

# Apuração do boletim de conjuntura (/boletim).
#
# Sem esta chave, a página abre e informa que a apuração está desligada; o
# restante do site continua estático e não depende dela. Note que ela NÃO tem
# prefixo NEXT_PUBLIC_, e não pode ganhar um: variável com esse prefixo é
# embutida no bundle do navegador, e chave embutida é chave publicada. Ela é
# lida só em src/app/api/boletim/route.ts, no servidor.
#
# A rota gasta por requisição. Limite a cota da chave no painel da Anthropic —
# o limite em memória do processo contém acidente, não ataque distribuído.
ANTHROPIC_API_KEY=""
