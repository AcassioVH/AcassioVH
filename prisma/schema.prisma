// Schema da Acássium Invest.
//
// Duas restrições moldam este arquivo, e vale enunciá-las antes de ler:
//
// 1. LIMITE REGULATÓRIO. Não existe coluna de rentabilidade, cotação, retorno,
//    nota ou nível de risco — em nenhuma tabela. Não é esquecimento: o que não
//    é armazenado não vaza em relatório, não é exportado por engano e não vira
//    base para uma feature futura que ninguém revisou. Guardamos o que o
//    usuário declarou, e nada derivado que implique avaliação.
//
// 2. LGPD. Carteira é dado financeiro sensível. Todo dado pessoal pendura em
//    `User` com `onDelete: Cascade`, então excluir a conta apaga tudo em uma
//    transação — sem varredura manual por tabela, que é onde o dado esquecido
//    costuma sobreviver.

generator client {
  provider = "prisma-client-js"
}

// A URL de conexão vive em `prisma.config.ts` (Prisma 7+), não aqui.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Hash argon2id. A senha em claro nunca chega ao banco nem ao log.
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Aceite explícito dos termos e do aviso de tratamento de dados (LGPD art. 8º).
  /// Guardamos o instante do aceite porque consentimento sem data não se prova.
  termsAcceptedAt DateTime

  assets   Asset[]
  sessions Session[]

  @@map("users")
}

/// Sessão persistida.
///
/// O cookie carrega um JWT curto, mas a sessão também vive aqui para que possa
/// ser revogada de fato — logout que só apaga cookie não invalida um token
/// copiado. Encerrar conta ou trocar senha revoga tudo.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Diagnóstico de segurança, não rastreamento. Expurgado junto com a sessão.
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Tentativa malsucedida de autenticação, para o limite de tentativas.
///
/// Fica no Postgres, e não em memória do processo, porque em serverless cada
/// requisição pode cair numa instância diferente — um contador em memória
/// pareceria proteger e não protegeria nada, que é o pior modo de falha
/// possível para um controle de segurança.
///
/// `key` é o HMAC do alvo do limite — "login:conta:<email>", "login:ip:<ip>" ou
/// "cadastro:ip:<ip>" — e não o valor em claro. A busca é por igualdade exata,
/// então cifrar não serviria aqui: o IV aleatório impediria encontrar a linha.
/// O HMAC preserva a consulta e tira e-mail e IP legíveis do banco. A
/// contrapartida assumida é que igualdade continua visível, aceitável para uma
/// tabela de contadores efêmeros. As linhas ainda são expurgadas ao sair da
/// janela, por retenção mínima.
model AuthAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("auth_attempts")
}

/// Um ativo declarado pelo usuário.
///
/// Tudo aqui é declaração do próprio usuário ou classificação derivada dela.
/// O sistema não busca preço, não calcula rendimento e não guarda histórico de
/// valor — `declaredValue` é uma foto do que o usuário informou, com a data em
/// que informou, e a interface apresenta o número exatamente assim.
model Asset {
  id     String @id @default(cuid())
  userId String

  // --- Campos cifrados em repouso (AES-256-GCM, ver src/lib/security/crypto.ts) ---
  //
  // Estes quatro são a carteira propriamente dita: o que, onde e quanto. Com um
  // dump do banco em mãos, é isso que causaria dano — por isso não ficam
  // legíveis. O tipo é String porque criptograma é opaco; a tipagem forte
  // sobrevive na fronteira da aplicação, que converte na leitura.

  /// Nome como o usuário digitou. Ex.: "CDB Banco Exemplo 2027". CIFRADO.
  name String
  /// CNPJ normalizado, 14 dígitos, sem máscara. Opcional. CIFRADO.
  cnpj String?
  /// Instituição informada pelo usuário. Base de concentração e FGC. CIFRADO.
  institution String?

  /// Valor declarado, em centavos, como texto decimal. CIFRADO.
  ///
  /// Continua sendo inteiro em centavos em toda a aplicação — dinheiro em ponto
  /// flutuante acumula erro de arredondamento, e num total de carteira isso vira
  /// centavo perdido que o usuário percebe. A cifra apenas o transporta como
  /// texto: `BigInt` no banco é incompatível com criptograma.
  declaredValueCents String
  /// Quando o usuário informou esse valor. Exibido junto ao número.
  declaredAt         DateTime @default(now())

  // --- Campos em claro, por decisão consciente ---
  //
  // `assetClass` e `maturityDate` ficam legíveis. Um dump revelaria a forma
  // aproximada da carteira ("tem CDB e FII, com algo vencendo em março"), sem
  // nome, instituição nem valor — bem menos danoso que a exposição completa, e
  // mantém os dois indexáveis para relatórios e lembretes futuros.
  //
  // Está registrado assim em docs/RISKS.md para ser reavaliado, não esquecido.

  /// Classe resolvida pelo motor de classificação, ou escolhida na mão.
  assetClass String
  /// ALTA | MEDIA | BAIXA — ver src/domain/assets/classify.ts.
  confidence String
  /// True quando o usuário confirmou (ou corrigiu) a classificação sugerida.
  classConfirmedByUser Boolean @default(false)

  /// Vencimento, quando o tipo de ativo tiver. Alimenta o calendário.
  maturityDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, assetClass])
  @@map("assets")
}
